# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET_NAME=your_bucket_name
AWS_S3_FOLDER=uploads

# Server Configuration
PORT=3000

# API Authentication
# Generate a secure token: openssl rand -base64 32
API_TOKEN=your-secure-api-token-here
# Set to 'false' to disable authentication (not recommended for production)
REQUIRE_AUTH=true

# MCP Server Configuration
# URL of the REST API that the MCP server queries
# For local development: http://localhost:3000
# For production: https://your-vercel-url.vercel.app
MCP_API_BASE_URL=http://localhost:3000

# Optional: Proxy Configuration
# HTTPS_PROXY=http://proxy-server:port
# HTTP_PROXY=http://proxy-server:port
